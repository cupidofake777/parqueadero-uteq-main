# Copia este archivo como .env.local y complétalo con los datos de tu
# proyecto de Supabase (Project Settings -> API).
#
# IMPORTANTE: usa siempre la clave publica "anon" / "publishable".
# NUNCA coloques aqui la "service_role key" (clave secreta): este
# archivo es leido por Vite y cualquier variable que empiece con
# VITE_ queda expuesta en el bundle que corre en el navegador.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_publica

# Endpoint REST de reconocimiento de placas (Monitoreo de entrada).
# El docente te entrega la URL completa, incluyendo el parámetro "?code=..."
# (es una clave de acceso a la Azure Function). NUNCA la escribas en el
# código ni la subas al repositorio: solo va aquí en .env.local (ignorado
# por git) y como secreto de GitHub Actions para el despliegue.
VITE_OCR_ENDPOINT=https://tu-endpoint-ocr.azurewebsites.net/api/detectar-placa?code=tu_codigo
